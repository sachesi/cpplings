# Maintainer: sachesi <xsachesi@pm.me>

# The release workflow sets pkgver to the tag it builds.
pkgname=cpplings
pkgver=0.1.0
pkgrel=1
pkgdesc='Small exercises to get you used to reading and writing modern C++'
arch=('x86_64' 'aarch64')
url='https://github.com/sachesi/cpplings'
license=('MIT')
# The exercises are compiled with `c++` while cpplings runs.
depends=('gcc' 'gcc-libs' 'glibc')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  local bin="$srcdir/build/cpplings" dir
  "$bin" --version
  dir=$(mktemp -d)
  (
    cd "$dir"
    echo | "$bin" init
    cd cpplings
    echo | "$bin" run intro1
    ! "$bin" run intro2
  )
  rm -rf "$dir"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$pkgname-$pkgver/README.md" -t "$pkgdir/usr/share/doc/$pkgname"
}
